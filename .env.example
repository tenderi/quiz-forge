# quiz-forge configuration. Copy to .env next to the binary (or set in the
# environment / systemd unit). Never commit the real file.

# Telegram: the bot token from @BotFather, and the group's chat id (a negative
# number; add the bot to the group, then see docs/DEPLOYMENT.md to find it).
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=-1001234567890

# Where the web app is reachable from browsers (used in login links).
PUBLIC_BASE_URL=https://quiz.example.org
# 127.0.0.1:PORT, or unix:/path/to.sock for a reverse proxy that shares a socket dir.
LISTEN=127.0.0.1:8090
# Database and media live here. Back it up (quiz-forge backup <dir>).
DATA_DIR=./var

DEFAULT_LANGUAGE=fi
VOTE_WINDOW_HOURS=168
VOTE_MIN_APPROVALS=1
MEDIA_MAX_IMAGE_MB=5
MEDIA_MAX_AUDIO_MB=20

# Optional AI review pass (off by default). When on, question text is sent to
# Anthropic's API; images only with AGENT_SEND_MEDIA=true.
AGENT_ENABLED=false
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_INTERVAL_HOURS=24
AGENT_MAX_QUESTIONS_PER_RUN=25
AGENT_MAX_COST_USD_PER_RUN=1.00
AGENT_SEND_MEDIA=false

# Logging (tracing env filter).
RUST_LOG=info,sqlx=warn,teloxide=warn
